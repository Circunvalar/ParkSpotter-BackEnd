# Variables del backend. Nunca subir .env al repositorio.
# - Local: copiar a .env en la raíz del repositorio y completar. Lo leen ./mvnw spring-boot:run,
#   IntelliJ (si el directorio de trabajo es la raíz) y docker compose.
#   Valores sin comillas y sin espacios alrededor del "=".
# - Azure App Service: no se usa este archivo; cada variable se carga en Application settings
#   (ver docs/Despliegue-Azure.md, paso 5), junto con WEBSITES_PORT=8080.

# --- Base de datos (Azure SQL) ---
# Obligatoria: la contraseña del usuario de la base (nunca en application.properties ni en git)
DB_PASSWORD=
# Opcionales: por defecto se usa el servidor parkspotter.database.windows.net, base ParkSpotterDatabase
# DB_URL=jdbc:sqlserver://parkspotter.database.windows.net:1433;database=ParkSpotterDatabase;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30
# DB_USERNAME=ParkSpotterDatabaseManager@parkspotter

# Crea los roles (usuario, conductor, propietario, admin) al arrancar. Dejar en true.
APP_BOOTSTRAP_ROLES=true

# --- Seguridad ---
# Obligatoria en producción. Generar con: openssl rand -hex 48 (mínimo 64 caracteres).
# En local se puede dejar comentada: se usa una clave de desarrollo. Nunca dejarla vacía.
# JWT_SECRET=
# Correo de la cuenta que será administradora (debe registrarse primero en la app)
ADMIN_EMAIL=
APP_CORS_ALLOWED_ORIGINS=https://parkspotter-web.ejemplo.com,http://localhost:3000

# --- Pagos ---
PAYMENTS_PROVIDER=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
PAYMENTS_REDIRECT_PREFIXES=https://parkspotter-web.ejemplo.com/,parkspotter://
PAYMENTS_DEFAULT_REDIRECT=https://parkspotter-web.ejemplo.com/pagos/resultado

# --- Correo (opcional; sin esto los correos solo van al log) ---
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=ParkSpotter <no-reply@parkspotter.co>
RESET_PASSWORD_URL=https://parkspotter-web.ejemplo.com/restablecer-contrasena

# --- Push con Firebase (opcional) ---
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# La clave privada en una sola línea, con \n donde van los saltos de línea
FCM_PRIVATE_KEY=
