# Variables del backend. Nunca subir .env al repositorio.
# - Local: copiar a .env en la raíz del repositorio y completar. Lo leen ./mvnw spring-boot:run,
#   IntelliJ (si el directorio de trabajo es la raíz) y docker compose.
#   Valores sin comillas y sin espacios alrededor del "=".
# - Render (producción): no se usa este archivo; cada variable se carga en Environment del servicio
#   (ver docs/Despliegue-Gratuito.md).

# --- Base de datos (PostgreSQL) ---
# Obligatoria. Con docker compose es la contraseña con la que se crea la base local (cualquiera sirve).
DB_PASSWORD=
# Sin DB_URL se usa jdbc:postgresql://localhost:5432/parkspotter con el usuario parkspotter (la base de
# docker compose). Para usar Neon desde la computadora:
# DB_URL=jdbc:postgresql://ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# DB_USERNAME=neondb_owner

# Crea los roles (usuario, conductor, propietario, admin) al arrancar. Dejar en true.
APP_BOOTSTRAP_ROLES=true

# --- Seguridad ---
# Obligatoria en producción. Generar con: openssl rand -hex 48 (mínimo 64 caracteres).
# En local se puede dejar comentada: se usa una clave de desarrollo. Nunca dejarla vacía.
# JWT_SECRET=
# Correo de la cuenta que será administradora (debe registrarse primero en la app)
ADMIN_EMAIL=
# Orígenes del front web separados por coma; se aceptan comodines como https://*.vercel.app
APP_CORS_ALLOWED_ORIGINS=https://parkspotter-web.vercel.app,http://localhost:3000

# --- Pagos ---
PAYMENTS_PROVIDER=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
PAYMENTS_REDIRECT_PREFIXES=https://parkspotter-web.vercel.app/,parkspotter://
PAYMENTS_DEFAULT_REDIRECT=https://parkspotter-web.vercel.app/pagos/resultado

# --- Correo (opcional; sin esto los correos solo van al log) ---
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=ParkSpotter <no-reply@parkspotter.co>
RESET_PASSWORD_URL=https://parkspotter-web.vercel.app/restablecer-contrasena

# --- Push con Firebase (opcional) ---
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# La clave privada en una sola línea, con \n donde van los saltos de línea
FCM_PRIVATE_KEY=

# --- Soporte (opcional; se muestran en la sección de ayuda) ---
SUPPORT_EMAIL=soporte@parkspotter.co
SUPPORT_PHONE=
