# Copiar a .env en el servidor y completar. Nunca subir .env al repositorio.

# --- Dominio para HTTPS (Caddy) ---
DOMAIN=api.midominio.com

# --- Base de datos (contenedor db) ---
POSTGRES_DB=parkspotter
POSTGRES_USER=parkspotter
POSTGRES_PASSWORD=cambia-esta-clave-larga

# --- Seguridad ---
# Generar con: openssl rand -hex 48
JWT_SECRET=
# Correo de la cuenta que será administradora (debe registrarse primero en la app)
ADMIN_EMAIL=
APP_CORS_ALLOWED_ORIGINS=https://parkspotter-web.ejemplo.com,http://localhost:3000

# --- Pagos ---
PAYMENTS_PROVIDER=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
PAYMENTS_REDIRECT_PREFIXES=https://parkspotter-web.ejemplo.com/,parkspotter://
PAYMENTS_DEFAULT_REDIRECT=https://parkspotter-web.ejemplo.com/pagos/resultado

# --- Correo (opcional; sin esto los correos solo van al log) ---
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=ParkSpotter <no-reply@parkspotter.co>
RESET_PASSWORD_URL=https://parkspotter-web.ejemplo.com/restablecer-contrasena

# --- Push con Firebase (opcional) ---
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# La clave privada en una sola línea, con \n donde van los saltos de línea
FCM_PRIVATE_KEY=
